<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ ignora o android:background do tema de abertura: ele monta a
      splash do sistema com uma cor de fundo e um ícone. Sem estes itens o
      sistema usaria o branco padrão, destoando do resto do app.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#27282D</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
